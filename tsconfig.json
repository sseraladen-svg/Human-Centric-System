{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./apps/web/*"],
      "@engine/*": ["./packages/engine/src/*"],
      "@shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": ["apps/web/**/*", "packages/**/*", "jobs/**/*"],
  "exclude": ["node_modules"]
}
